# Copy to .env.local for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.

# Gemini API key — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY is read at build time by vite.config.ts (define) and the local PH-Scout server.
GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_API_KEY=your_gemini_api_key

# Supabase — project URL + anon (publishable) key only. Safe to expose to the browser.
# NEVER put the service_role key here: any VITE_-prefixed var is shipped to the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
